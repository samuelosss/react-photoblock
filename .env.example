# Environment variables for a BACKEND that implements the Google Photos
# picker adapter described in docs/google-photos-setup.md. This package is
# frontend-only and never reads these itself — nothing in src/ touches
# process.env. This file exists purely as a checklist for whoever wires up
# the four adapter functions (startGooglePhotosPicker, pollGooglePhotosBridge,
# pollGooglePhotosSession, importGooglePhotosSession) server-side.
#
# No values are filled in here, and this file is safe to commit — .gitignore
# excludes the real `.env` it would be copied to.

# From Google Cloud Console -> APIs & Services -> Credentials, an OAuth 2.0
# Client ID of type "Web application". See docs/google-photos-setup.md for
# the exact scopes and setup steps.
GOOGLE_PHOTOS_CLIENT_ID=

# The matching client secret. THIS MUST NEVER REACH THE FRONTEND — keep it
# in server-side config only (a secrets manager, not a bundled .env in a
# public deploy). This package's frontend code has no field for it, no
# import of it, and no way to leak it, by construction: the frontend only
# ever calls the four adapter functions, which return an already-built
# redirect URL and poll results, never a credential.
GOOGLE_PHOTOS_CLIENT_SECRET=

# Must exactly match one of the "Authorized redirect URIs" configured on
# the OAuth client above, e.g. https://your-api.example.com/photos/google/callback
GOOGLE_PHOTOS_REDIRECT_URI=
